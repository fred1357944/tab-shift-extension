{
  "manifest_version": 3,
  "name": "Tab Shift",
  "description": "iTerm-like keyboard shortcuts to rearrange Chrome tabs and move them between windows.",
  "version": "1.0.0",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Tab Shift",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "move-tab-left": {
      "suggested_key": {
        "default": "Ctrl+Shift+Left",
        "mac": "Shift+Command+Left"
      },
      "description": "Move active tab left"
    },
    "move-tab-right": {
      "suggested_key": {
        "default": "Ctrl+Shift+Right",
        "mac": "Shift+Command+Right"
      },
      "description": "Move active tab right"
    },
    "move-tab-to-start": {
      "suggested_key": {
        "default": "Ctrl+Shift+Up",
        "mac": "Shift+Command+Up"
      },
      "description": "Move active tab to start of its strip"
    },
    "move-tab-to-end": {
      "suggested_key": {
        "default": "Ctrl+Shift+Down",
        "mac": "Shift+Command+Down"
      },
      "description": "Move active tab to end of its strip"
    },
    "extract-tab-new-window": {
      "description": "Extract active tab to a new window"
    },
    "move-tab-next-window": {
      "description": "Move active tab to the next window"
    }
  }
}
